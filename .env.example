# ==============================================================================
# TechNoir-RAG Environment Configuration
# Local-First, Self-Hosted Document Intelligence
# ==============================================================================

# ── 1. Provider Selection ─────────────────────────────────────────────────────
# Options: 'ollama' (free, 100% private, runs locally) or 'gemini' (cloud API)
# Model generation and embeddings are independently configurable!
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ── 2. Local-First / Ollama Settings (Zero API Cost) ──────────────────────────
# Default Ollama address. If running in Docker on Windows/Mac, use:
# http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Pull your desired model locally with: `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
# Pull your embedding model with: `ollama pull nomic-embed-text`
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── 3. Single-User / Local Mode ───────────────────────────────────────────────
# When LOCAL_MODE is true, authentication is streamlined for personal desktop use.
LOCAL_MODE=true
# Set AUTH_OPTIONAL=true to skip login requirements on personal machines
AUTH_OPTIONAL=false
# Secret key for JWT session tokens (auto-fallback provided in LOCAL_MODE)
SECRET_KEY=change-this-to-a-secure-random-string-for-production

# ── 4. Cloud / Google Gemini Configuration (Optional BYO-Key) ─────────────────
# Leave blank if using Ollama. Set if you want to use Google Gemini instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBED_MODEL=models/gemini-embedding-001

# ── 5. Vector Store & Storage Paths ───────────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_db
PDF_STORE_PATH=./pdf_store

# ── 6. Ingestion Limits & Chunking ────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=80
MAX_UPLOAD_BYTES=26214400 # 25 MB
MAX_INGEST_PAGES=100

# ── 7. Network & CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
